{
  "name": "@dege00/patu",
  "version": "0.0.1",
  "description": "Gerenciador de estado tipo o pinia mas sem o vue",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --clean && tsc -p tsconfig.build.json",
    "dev": "tsup src/index.ts --format esm,cjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "pinia",
    "state-management",
    "vue",
    "react",
    "reactive"
  ],
  "author": "dege00",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dege00/Pato.git"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
